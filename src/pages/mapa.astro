---
import Layout from "@/layouts/main.astro"
import "maplibre-gl/dist/maplibre-gl.css"
import "@/styles/moon-map.css"
import { breadcrumbs } from "@/lib/seo"
import { getPins, type Pin } from "@/lib/pins"
import Moon from "@/components/moon.astro"
import DualRange from "@/components/dual-range.astro"

const pins = await getPins()

// Quick jumps: the cities with most pins, framed on their own pins
const byCity = new Map<string, Pin[]>()
for (const p of pins) byCity.set(p.city, [...(byCity.get(p.city) ?? []), p])
const cities = [...byCity]
  .sort((a, b) => b[1].length - a[1].length)
  .slice(0, 10)
  .map(([city, list]) => {
    const lons = list.map((p) => p.lon)
    const lats = list.map((p) => p.lat)
    return {
      city,
      count: list.length,
      bounds: [
        Math.min(...lons),
        Math.min(...lats),
        Math.max(...lons),
        Math.max(...lats),
      ].join(","),
    }
  })
const SPAIN = "-9.6,35.8,4.4,43.9"
---

<Layout
  title="Mapa de lunas · Alberto de Luna"
  jsonLd={breadcrumbs([
    ["Inicio", "/"],
    ["Mapa de lunas", "/mapa/"],
  ])}
  description={`Los ${pins.length} restaurantes de Alberto de Luna en el mapa, cada uno con la luna de su nota.`}
>
  <main class="map-page" data-moon-map data-lenis-prevent>
    <div class="map" data-map></div>
    <script type="application/json" data-pins set:html={JSON.stringify(pins)} />
    <aside class="panel">
      <span class="eyebrow">Mapa de lunas</span>
      <h1>
        <span data-count>{pins.length}</span> restaurantes
        <br /> en lunas
      </h1>

      {/* Same filter as the review list: a from–to range of lunas */}
      <fieldset class="group">
        <legend class="label">
          Lunas <output data-score-out>0–10</output>
        </legend>
        <div class="range">
          <Moon score={0} class="range-moon" />
          <DualRange name="score" min={0} max={10} step={0.5} label="Lunas" />
        </div>
      </fieldset>

      <div class="jumps" role="group" aria-label="Ir a">
        <button type="button" data-fly={SPAIN}>
          España
        </button>
        {cities.map((c) => (
          <button type="button" data-fly={c.bounds}>
            {c.city}
            <small>{c.count}</small>
          </button>
        ))}
        <button type="button" class="near" data-near>
          Cerca de mí
        </button>
      </div>
    </aside>
    <noscript>
      <p class="noscript">El mapa necesita JavaScript.</p>
    </noscript>
  </main>
</Layout>

<script>
  import { moonMap, type Pin } from "@/lib/moon-map"
  const root = document.querySelector<HTMLElement>("[data-moon-map]")!
  const pins = JSON.parse(
    root.querySelector("[data-pins]")!.textContent!
  ) as Pin[]
  moonMap(root, pins)
</script>

<style>
  .map-page {
    position: relative;
    height: 100svh;
    min-height: 560px;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }
  .map {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s;
  }
  .map-page[data-ready] .map {
    opacity: 1;
  }
  .panel {
    position: absolute;
    top: 84px;
    left: 24px;
    z-index: 2;
    width: min(360px, calc(100% - 48px));
    padding: 22px;
    container-type: inline-size;
    border-radius: 6px;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--paper) 12%, transparent);
  }
  /* Sized to the panel, not the screen: "restaurantes" has to fit its width */
  h1 {
    margin: 10px 0 0;
    font: 900 min(40px, 8.6cqi) / 0.92 var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  [data-count] {
    color: var(--glow);
    font-variant-numeric: tabular-nums;
  }
  /* The review list's filters (restaurantes/index.astro), on the night:
     sky glow where the list uses deep royal */
  .group {
    margin: 22px 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .label {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 10px;
    padding: 0;
    font: 800 12px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .label output {
    color: var(--glow);
  }
  .range {
    display: flex;
    align-items: center;
    gap: 12px;
    --dual-track: var(--dim);
    --dual-fill: var(--glow);
    --dual-ring: var(--ink);
  }
  .range :global(.range-moon) {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    --moon-base: var(--night);
    --moon-ring: var(--dim);
    --moon-lit: var(--moon);
  }
  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }
  .jumps button {
    cursor: pointer;
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    border: 1.5px solid currentColor;
    border-radius: 99px;
    padding: 7px 12px 6px;
    background: transparent;
    color: inherit;
    font: 700 12px/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition:
      color 0.2s,
      border-color 0.2s,
      opacity 0.25s ease;
  }
  .jumps small {
    font-size: 11px;
    color: var(--grey);
  }
  .jumps button:hover {
    border-color: var(--glow);
    color: var(--glow);
  }
  .jumps button:hover small {
    color: inherit;
  }
  @media (hover: hover) and (pointer: fine) {
    .jumps:has(button:hover) button:not(:hover) {
      opacity: 0.45;
    }
  }
  .noscript {
    position: absolute;
    inset: auto 24px 24px;
  }

  @media (max-width: 640px) {
    .panel {
      top: auto;
      bottom: 72px;
      left: 16px;
      width: calc(100% - 32px);
      padding: 16px;
    }
    .jumps {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .jumps button {
      flex-shrink: 0;
    }
  }
</style>
